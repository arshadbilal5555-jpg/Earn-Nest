{
  "$schema": "https://openapi.vercel.sh/vercel.json",

  "functions": {
    "api/index.js": {
      "maxDuration": 30
    }
  },

  "rewrites": [

    {
      "source": "/api/:path*",
      "destination": "/api/index.js"
    },

    {
      "source": "/health",
      "destination": "/api/index.js"
    },

    {
      "source": "/admin",
      "destination": "/app/admin.html"
    },

    {
      "source": "/admin.html",
      "destination": "/app/admin.html"
    },

    {
      "source": "/dashboard",
      "destination": "/app/dashboard.html"
    },

    {
      "source": "/dashboard.html",
      "destination": "/app/dashboard.html"
    },

    {
      "source": "/",
      "destination": "/app/index.html"
    }
  ]
}
