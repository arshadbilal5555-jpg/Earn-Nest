{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/health",
      "destination": "/api/health.js"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/dashboard.html",
      "destination": "/app/dashboard.html"
    },
    {
      "source": "/admin.html",
      "destination": "/app/Admin.html"
    },
    {
      "source": "/",
      "destination": "/app/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/app/$1"
    }
  ]
}
