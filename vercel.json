{
  "$schema": "https://openapi.vercel.sh/vercel.json",

  "functions": {
    "api/index.js": {
      "maxDuration": 30
    },
    "api/tasks/complete.js": {
      "maxDuration": 30
    },
    "api/surveys/complete.js": {
      "maxDuration": 30
    }
  },

  "rewrites": [
    {
      "source": "/api/tasks/complete",
      "destination": "/api/tasks/complete.js"
    },
    {
      "source": "/api/surveys/complete",
      "destination": "/api/surveys/complete.js"
    },
    {
      "source": "/api/health",
      "destination": "/api/health.js"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/index.js"
    },
    {
      "source": "/health",
      "destination": "/api/index.js"
    },
    {
      "source": "/",
      "destination": "/app/index.html"
    },
    {
      "source": "/admin",
      "destination": "/app/admin.html"
    },
    {
      "source": "/admin.html",
      "destination": "/app/admin.html"
    }
  ]
}
