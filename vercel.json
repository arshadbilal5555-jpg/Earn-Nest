{
  "$schema": "https://openapi.vercel.sh/vercel.json",

  "builds": [
    {
      "src": "api/**/*.js",
      "use": "@vercel/node"
    },
    {
      "src": "app/**/*.html",
      "use": "@vercel/static"
    }
  ],

  "routes": [
    {
      "src": "/api/health",
      "dest": "/api/health.js"
    },
    {
      "src": "/api/tasks/complete",
      "dest": "/api/tasks/complete.js"
    },
    {
      "src": "/api/surveys/complete",
      "dest": "/api/surveys/complete.js"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/index.js"
    },
    {
      "src": "/dashboard.html",
      "dest": "/app/dashboard.html"
    },
    {
      "src": "/admin.html",
      "dest": "/app/Admin.html"
    },
    {
      "src": "/",
      "dest": "/app/index.html"
    },
    {
      "src": "/(.*)",
      "dest": "/app/$1"
    }
  ]
}
