{
  "version": 2,
  "builds": [
    {
      "src": "api/**/*.js",
      "use": "@vercel/node"
    },
    {
      "src": "app/**/*.html",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/health",
      "dest": "/api/health.js"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/index.js"
    },
    {
      "src": "/dashboard.html",
      "dest": "/app/dashboard.html"
    },
    {
      "src": "/index.html",
      "dest": "/app/index.html"
    },
    {
      "src": "/",
      "dest": "/app/index.html"
    },
    {
      "src": "/(.*)",
      "dest": "/app/$1"
    }
  ]
}
