# Core
NODE_ENV=production
PORT=4000
ADMIN_EMAIL=admin@earnnest.com
ADMIN_PASSWORD=CHANGE_THIS_TO_A_LONG_RANDOM_PASSWORD

# Google Identity Services
GOOGLE_CLIENT_ID=

# Email via Resend
RESEND_API_KEY=
EMAIL_FROM=EarnNest <no-reply@yourdomain.com>

# Optional SMS bridge (your provider endpoint receives {to,code,purpose,expiresAt})
SMS_WEBHOOK_URL=
SMS_WEBHOOK_SECRET=

# Verified task/survey provider webhook
PROVIDER_WEBHOOK_SECRET=

# Optional: connect your payout service/finance bridge in your own infrastructure
PAYOUT_PROVIDER_URL=
PAYOUT_PROVIDER_SECRET=

# Set false in production so demo buttons cannot create real rewards
DEMO_MODE=false

# Required in production when KYC documents are enabled
KYC_ENCRYPTION_KEY=
